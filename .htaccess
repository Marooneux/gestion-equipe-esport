RewriteEngine On

# URL rewriting
RewriteRule ^auth/login/?$ api/get_token.php [L]
RewriteRule ^auth/verify/?$ api/verify_token.php [L]
RewriteRule ^docs/?$ docs/index.html [L]

# Block access to sensitive files
<Files ".env">
    Require all denied
</Files>

<Files "*.sql">
    Require all denied
</Files>
